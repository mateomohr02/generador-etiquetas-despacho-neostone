{
  "name": "generador-etiquetas-despacho-neostone",
  "version": "0.1.0",
  "description": "Generador e impresor de etiquetas de despacho (Zebra GK420t) para pedidos Teowin",
  "private": true,
  "main": "src/electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-packager . \"Etiquetas Despacho Neostone\" --platform=win32 --arch=x64 --out=dist --overwrite --ignore=\"^/\\.env$\" --ignore=\"^/\\.env\\.example$\" --ignore=\"^/dist($|/)\" --ignore=\"^/\\.git($|/)\""
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "mssql": "^10.0.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-packager": "^17.1.2"
  }
}
